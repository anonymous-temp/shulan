# 开发环境配置模板（可提交版本库，不含密文）
# 使用方式：cp .env.example.dev .env，然后填入密文配置项（LLM、DocMind、MongoDB、Redis、知识库）
# 一致性校验：
#     check-env --example .env.example --env .env.example.dev
#     check-env --example .env.example.dev

# Project
# SHULAN_ENVIRONMENT 可选 dev / test / production
# SHULAN_LOG_LEVEL   可选 DEBUG / INFO / WARNING / ERROR / CRITICAL
SHULAN_ENVIRONMENT=dev
SHULAN_DEBUG=true
SHULAN_LOG_LEVEL=DEBUG
SHULAN_SERVER_PORT=9002

# 文件日志：每个目录仅一个服务进程写入；相对目录基于项目根目录
SHULAN_LOG_FILE_ENABLED=true
SHULAN_LOG_DIR=logs
SHULAN_LOG_MAX_BYTES=1048576
SHULAN_LOG_RETENTION_DAYS=30
SHULAN_LOG_BACKUP_COUNT=100
SHULAN_LOG_USER_MAX_OPEN_FILES=128
SHULAN_LOG_QUEUE_CAPACITY=1000

# HTTP 请求/响应日志预览（只影响日志；详细说明：wiki/http-logging.md）
SHULAN_HTTP_LOG_BODY_ENABLED=true
SHULAN_HTTP_LOG_STRING_CHARS=2000
SHULAN_HTTP_LOG_LIST_ITEMS=20
SHULAN_HTTP_LOG_DICT_ITEMS=50
SHULAN_HTTP_LOG_DEPTH=8
SHULAN_HTTP_LOG_TOTAL_BYTES=32768
SHULAN_HTTP_LOG_PARSE_BYTES=1048576

# Chat / Record SSE 文本合并：累计字符数或等待秒数，任一达到就发送；修改后重启后端。
SHULAN_SSE_TEXT_BATCH_CHARS=512
SHULAN_SSE_TEXT_BATCH_SECONDS=0.05

# LLM API KEY
SHULAN_LLM_PROVIDER=
SHULAN_LLM_API_KEY=sk-xxx
SHULAN_LLM_DEFAULT_MODEL=

# 阿里云文档智能解析平台（体检报告解析）
SHULAN_ALIYUN_DOCMIND_ACCESSKEY_ID=xxx
SHULAN_ALIYUN_DOCMIND_ACCESSKEY_SECRET=xxx
SHULAN_ALIYUN_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com

# MongoDB
SHULAN_MONGODB_URI=mongodb://localhost:27017
SHULAN_MONGODB_DATABASE=database_name
SHULAN_MONGODB_COLL_SESSIONS=collection_name
SHULAN_MONGODB_COLL_QUESTIONNAIRES=record_questionnaires
SHULAN_MONGODB_COLL_QUESTIONNAIRE_DOCUMENTS=questionnaire_documents
SHULAN_MONGODB_COLL_QUESTIONNAIRE_CHUNKS=questionnaire_document_chunks
SHULAN_MONGODB_COLL_QUESTIONNAIRE_FACTOR_TASKS=questionnaire_factor_tasks
SHULAN_MONGODB_COLL_HEALTH_REPORTS=collection_name
SHULAN_MONGODB_COLL_DOCUMENT_TRACES=document_traces
SHULAN_MONGODB_COLL_DOCUMENT_INDEX=document_index
SHULAN_MONGODB_COLL_DOCUMENT_EXTRACTIONS=document_extractions
SHULAN_MONGODB_COLL_DOCUMENT_OBSERVATIONS=document_observations
SHULAN_MONGODB_COLL_HEALTH_REPORT_REVISIONS=health_report_revisions
SHULAN_MONGODB_COLL_DOCUMENT_TRACE_CHUNKS=document_trace_chunks
SHULAN_MONGODB_COLL_AGENT_LLM_CONTEXTS=agent_llm_contexts
SHULAN_MONGODB_COLL_AGENT_TOOL_RUNS=agent_tool_runs
SHULAN_MONGODB_COLL_AGENT_CHECKPOINTS=agent_checkpoints
SHULAN_MONGODB_COLL_AGENT_CHECKPOINT_WRITES=agent_checkpoint_writes
SHULAN_MONGODB_COLL_CHAT_CUSTOM_MESSAGE_OUTBOX=chat_custom_message_outbox
SHULAN_MONGODB_COLL_HEALTH_SUBJECTS=health_subjects
SHULAN_MONGODB_COLL_HEALTH_PROFILE_FACTS=health_profile_facts
SHULAN_MONGODB_COLL_HEALTH_PROFILE_EVENTS=health_profile_events
SHULAN_MONGODB_COLL_HEALTH_PROFILE_VIEWS=health_profile_views
SHULAN_MONGODB_COLL_HEALTH_PROFILE_JOBS=health_profile_jobs
SHULAN_MONGODB_COLL_HEALTH_PROFILE_SOURCE_PUBLICATIONS=health_profile_source_publications
SHULAN_MONGODB_COLL_HEALTH_PROFILE_EVIDENCE_RESULTS=health_profile_evidence_results
SHULAN_MONGODB_COLL_REPORT_BATCHES=report_batches
SHULAN_MONGODB_COLL_REPORT_ARTIFACTS=report_artifacts
SHULAN_MONGODB_COLL_REPORT_CALLBACK_DELIVERIES=report_callback_deliveries
SHULAN_MONGODB_COLL_HEALTH_ANALYSIS_RUNS=health_analysis_runs

# Redis
# SHULAN_REDIS_MODE 可选 single / sentinel / cluster
SHULAN_REDIS_HOST=localhost
SHULAN_REDIS_PORT=6379
SHULAN_REDIS_MODE=single
SHULAN_REDIS_DB=0
SHULAN_REDIS_PASSWORD=
SHULAN_REDIS_PROTOCOL_VERSION=2

# Agent runtime
SHULAN_AGENT_LEASE_TTL_SECONDS=300

# Agent 医学知识库检索（可选；密钥为空时不启用检索）
SHULAN_KNOWLEDGE_API_BASE_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api/review/api/v2
SHULAN_KNOWLEDGE_API_KEY=
SHULAN_KNOWLEDGE_API_TIMEOUT_SECONDS=20

# 备用群聊查询工具的完整 POST 地址；暂未接入业务，由部署方填写。
SHULAN_CHAT_HISTORY_QUERY_URL=

# REPORT CALLBACK URL
# 开发模拟回调：python -m tests.api.serve_pages（异机运行时替换为后端可达 IP）
# 独立接收端 python -m tests.api.scripts.report_callback_server 默认使用 10002 端口
SHULAN_REPORT_CALLBACK_URL=http://127.0.0.1:9080/callback
# 本地开发留空时，评估报告使用上面的模拟接收端
SHULAN_REPORT_EVALUATE_CALLBACK_URL=
# 回调失败后的等待秒数：逗号分隔、正整数、非递减；最后一项持续重复，不限制次数
SHULAN_REPORT_CALLBACK_RETRY_DELAYS_SECONDS=30,120,600,3600
# 到期任务扫描周期（秒）；新产物入队也会立即唤醒投递
SHULAN_REPORT_CALLBACK_POLL_INTERVAL_SECONDS=5
SHULAN_REPORT_CALLBACK_CONCURRENCY=4
# 总请求超时（1—60 秒），需给 120 秒领取租约留出余量
SHULAN_REPORT_CALLBACK_TIMEOUT_SECONDS=15
# 每轮扫描最多领取的任务数（不是最大重试次数）
SHULAN_REPORT_CALLBACK_BATCH_SIZE=100
# 随机缩短间隔的最大比例：[0, 1)，0 关闭错峰；Retry-After 仍可延后
SHULAN_REPORT_CALLBACK_RETRY_JITTER_RATIO=0.1
# 积压汇总日志的最小输出间隔（秒），独立于扫描和重试
SHULAN_REPORT_CALLBACK_BACKLOG_LOG_INTERVAL_SECONDS=300
SHULAN_REPORT_GENERATION_TIMEOUT_SECONDS=1800

# 可选研究循环：默认关闭；启用前填写明确预算、模型和经审核的评测记录。
SHULAN_REPORT_RESEARCH_ENABLED=false
SHULAN_REPORT_RESEARCH_MAX_MODEL_CALLS=0
SHULAN_REPORT_RESEARCH_MAX_TOOL_CALLS=0
SHULAN_REPORT_RESEARCH_TIMEOUT_SECONDS=0
SHULAN_REPORT_RESEARCH_EVALUATION_REFERENCE=
SHULAN_REPORT_RESEARCH_MODEL=

# 报告推荐产品接口
SHULAN_REPORT_PRODUCT_URL=https://test.slmc.top/api/gut-product/catalog

# EviMed（菌群报告证据检索；未配置时报告以 partial_success 回调）
SHULAN_EVIMED_API_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api
SHULAN_EVIMED_API_KEY=
SHULAN_EVIMED_TIMEOUT=20

# 公共医学证据兜底（可选；NCBI 未配置 API key 也可使用）
SHULAN_NCBI_API_KEY=
SHULAN_NCBI_CONTACT_EMAIL=
SHULAN_CROSSREF_MAILTO=
